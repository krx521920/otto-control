{
  admin off
  email {$ACME_EMAIL}
  acme_ca {$ACME_CA}
}

{$CONTROL_DOMAIN} {
  encode zstd gzip

  @internal_metrics path /metrics
  respond @internal_metrics 404

  reverse_proxy control-a:7788 control-b:7788 control-c:7788 {
    lb_policy least_conn
    health_uri /health/ready
    health_interval 10s
    health_timeout 3s
    fail_duration 30s
    max_fails 2
    lb_try_duration 5s
    lb_try_interval 250ms
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}

{$FEDERATION_DOMAIN} {
  encode zstd gzip

  @internal_metrics path /metrics
  respond @internal_metrics 404

  # Federation administration is only reachable on the private service network.
  @federation_admin path /v1/admin/federation/*
  respond @federation_admin 404

  reverse_proxy federation-a:7790 federation-b:7790 federation-c:7790 {
    lb_policy least_conn
    health_uri /health/ready
    health_interval 10s
    health_timeout 3s
    fail_duration 30s
    max_fails 2
    lb_try_duration 5s
    lb_try_interval 250ms
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}

{$EDGE_DOMAIN} {
  encode zstd gzip

  @edge_api path /v1/chat/completions /v1/responses
  handle @edge_api {
    reverse_proxy edge-gateway:7791 {
      health_uri /readyz
      health_interval 10s
      health_timeout 3s
      fail_duration 30s
      max_fails 2
    }
  }

  @edge_health path /healthz /readyz
  handle @edge_health {
    reverse_proxy edge-gateway:7791
  }

  # Operations, billing recovery and every unknown path stay private.
  handle {
    respond 404
  }

  request_body {
    max_size 4MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    -Server
  }
}
