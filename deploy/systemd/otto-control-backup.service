[Unit]
Description=Back up Otto Control PostgreSQL
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
ConditionPathExists=/opt/otto-control/.env.production

[Service]
Type=oneshot
WorkingDirectory=/opt/otto-control
ExecStart=/bin/sh /opt/otto-control/deploy/backup-postgres.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
