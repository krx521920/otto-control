[Unit]
Description=Restore Otto Control pgBackRest backup into an isolated PostgreSQL instance
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/otto-control/.env.production

[Service]
Type=oneshot
WorkingDirectory=/opt/otto-control
ExecStart=/bin/sh /opt/otto-control/deploy/drill-pitr-postgres.sh
TimeoutStartSec=6h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
