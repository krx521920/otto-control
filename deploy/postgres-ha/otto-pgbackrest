#!/bin/sh
set -eu

CIPHER_FILE=${OTTO_PGBACKREST_CIPHER_FILE:-/run/secrets/pgbackrest_cipher_pass}
if [ ! -s "$CIPHER_FILE" ]; then
  printf '%s\n' 'pgBackRest repository encryption secret is missing' >&2
  exit 1
fi

PGBACKREST_REPO1_CIPHER_PASS=$(cat "$CIPHER_FILE")
export PGBACKREST_REPO1_CIPHER_PASS

exec pgbackrest \
  --config=/etc/pgbackrest/pgbackrest.conf \
  "$@"
