#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
  exec gosu postgres "$0" "$@"
fi

CIPHER_FILE=${OTTO_PGBACKREST_CIPHER_FILE:-/run/patroni/pgbackrest_cipher_pass}
if [ ! -s "$CIPHER_FILE" ]; then
  printf '%s\n' 'pgBackRest repository encryption secret is missing' >&2
  exit 1
fi

PGBACKREST_REPO1_CIPHER_PASS=$(cat "$CIPHER_FILE")
export PGBACKREST_REPO1_CIPHER_PASS

for argument in "$@"; do
  case "$argument" in
    --config|--config=*)
      exec pgbackrest "$@"
      ;;
  esac
done

exec pgbackrest --config=/etc/pgbackrest/pgbackrest.conf "$@"
