NODE_ENV=development
CONTROL_HOST=127.0.0.1
CONTROL_PORT=7788
CONTROL_LOG_LEVEL=info
CONTROL_TRUST_PROXY=false
CONTROL_PUBLIC_BASE_URL=
CONTROL_DATABASE_URL=
# Docker secrets deployment may use the component settings below instead of CONTROL_DATABASE_URL.
CONTROL_DATABASE_HOST=
CONTROL_DATABASE_PORT=
CONTROL_DATABASE_NAME=
CONTROL_DATABASE_USER=
CONTROL_DATABASE_PASSWORD=
CONTROL_DATABASE_PASSWORD_FILE=
CONTROL_DATABASE_SSL=false
# First-admin bootstrap secret only; normal administration uses MFA sessions.
CONTROL_ADMIN_TOKEN=
CONTROL_ADMIN_TOKEN_FILE=
CONTROL_TOKEN_SECRET=
CONTROL_TOKEN_SECRET_FILE=
CONTROL_SIGNER_PRIVATE_KEY_FILE=
# Versioned keyring manifest. Cannot be combined with CONTROL_SIGNER_PRIVATE_KEY_FILE.
CONTROL_SIGNER_KEYRING_FILE=
CONTROL_LEASE_DURATION_MS=600000
CONTROL_TELEMETRY_RETENTION_DAYS=90
CONTROL_UPDATE_POLICY_DURATION_MS=300000
CONTROL_BACKUP_RETENTION_DAYS=30
CONTROL_DRILL_REPORT_RETENTION_DAYS=180
CONTROL_DRILL_MAX_BACKUP_AGE_HOURS=48
OTTO_CONTROL_BACKUP_KEY_FILE=
