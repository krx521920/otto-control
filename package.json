{
  "name": "otto-control",
  "version": "0.21.0",
  "private": true,
  "description": "Commercial control plane for Otto private deployments",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bootstrap:production": "node scripts/bootstrap-production.mjs",
    "backup:production": "sh deploy/backup-postgres.sh",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/server.ts",
    "drill:restore:production": "sh deploy/drill-restore-postgres.sh",
    "drill:failover:production": "sh deploy/drill-postgres-failover.sh --confirm=FAILOVER_OTTO_CONTROL",
    "drill:pitr:production": "sh deploy/drill-pitr-postgres.sh",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "restore:production": "sh deploy/restore-postgres.sh",
    "backup:pitr:production": "sh deploy/backup-pitr-postgres.sh diff",
    "test": "vitest run",
    "test:postgres": "vitest run test/postgres-integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "fastify": "^5.8.5",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
