{
  "name": "otto-control",
  "version": "0.34.0",
  "private": true,
  "description": "Commercial control plane for Otto private deployments",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bootstrap:production": "node scripts/bootstrap-production.mjs",
    "preflight:deployment": "node scripts/preflight-deployment.mjs",
    "backup:production": "sh deploy/backup-postgres.sh",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run check:scripts && npm test && npm run build",
    "check:scripts": "node --check scripts/smoke-federation.mjs",
    "dev": "tsx watch src/server.ts",
    "dev:edge": "tsx watch src/edge-gateway/server.ts",
    "dev:federation": "tsx watch src/federation-server.ts",
    "drill:restore:production": "sh deploy/drill-restore-postgres.sh",
    "drill:failover:production": "sh deploy/drill-postgres-failover.sh --confirm=FAILOVER_OTTO_CONTROL",
    "drill:control:production": "sh deploy/drill-control-failover.sh --confirm=FAILOVER_OTTO_CONTROL_REPLICAS",
    "drill:pitr:production": "sh deploy/drill-pitr-postgres.sh",
    "drill:signing:provider": "node scripts/drill-signing-provider.mjs",
    "drill:signing:rotation": "node scripts/drill-signing-rotation.mjs",
    "drill:signing:revoke": "node scripts/drill-signing-revocation.mjs",
    "drill:audit:worm": "node scripts/drill-audit-worm.mjs",
    "drill:audit:object-lock": "node scripts/drill-object-lock.mjs",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "start:edge": "node dist/edge-gateway/server.js",
    "start:federation": "node dist/federation-server.js",
    "restore:production": "sh deploy/restore-postgres.sh",
    "backup:pitr:production": "sh deploy/backup-pitr-postgres.sh diff",
    "attest:release": "node scripts/attest-release-artifact.mjs",
    "test": "vitest run",
    "test:edge": "vitest run test/edge-gateway.test.ts test/edge-gateway-properties.test.ts test/edge-gateway-control.test.ts test/edge-gateway-control-billing-coordinator.test.ts test/edge-gateway-control-keyring-verifier.test.ts test/edge-gateway-control-policy-source.test.ts test/edge-gateway-circuit-breaker.test.ts test/edge-gateway-concurrency-limit.test.ts test/edge-gateway-lifecycle.test.ts test/edge-gateway-node-adapter.test.ts test/edge-gateway-node-http-limits.test.ts test/edge-gateway-operations.test.ts test/edge-gateway-protocol.test.ts test/edge-gateway-readiness.test.ts test/edge-gateway-redis-rate-limit.test.ts test/edge-gateway-usage-meter.test.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:property": "vitest run test/edge-gateway-properties.test.ts",
    "test:postgres": "vitest run test/postgres-integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-sts": "^3.1101.0",
    "@aws-sdk/credential-provider-http": "^3.972.67",
    "@aws-sdk/credential-provider-web-identity": "^3.972.71",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@smithy/credential-provider-imds": "^4.4.16",
    "fastify": "^5.8.5",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "redis": "4.7.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
